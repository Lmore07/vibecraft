---
// InteractiveCalculator.astro
---

<section id="calculator" class="py-20 bg-[#F8FAFC] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-12">
      <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#EEF2FF] text-[#4F46E5] border border-[#E0E7FF]">
        Simulador en Vivo
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0F172A] font-['Plus_Jakarta_Sans']">
        Prueba el Motor de Cálculo de DuoLedger
      </h2>
      <p class="text-sm sm:text-base text-[#64748B]">
        Descubre cómo resolvemos la división de gastos sin discusiones ni redondeos injustos en tiempo real.
      </p>
    </div>

    <!-- Card Calculator -->
    <div class="max-w-2xl mx-auto bg-white rounded-3xl p-6 sm:p-10 border border-[#F1F5F9] shadow-xl shadow-[#6366F1]/5">
      
      <div class="space-y-6">
        
        <!-- Input Amount -->
        <div>
          <label for="calc-amount" class="block text-xs font-bold uppercase tracking-wider text-[#64748B] mb-2">
            Monto del Gasto (USD)
          </label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-2xl font-bold text-[#94A3B8]">$</span>
            <input
              id="calc-amount"
              type="number"
              value="120"
              min="1"
              step="any"
              class="w-full pl-10 pr-4 py-3.5 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] text-2xl font-extrabold text-[#0F172A] focus:outline-none focus:border-[#6366F1] focus:ring-4 focus:ring-[#EEF2FF] transition-all"
            />
          </div>
        </div>

        <!-- Split Mode Buttons -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-[#64748B] mb-2">
            Modo de División
          </label>
          <div class="grid grid-cols-3 gap-2">
            <button
              type="button"
              data-mode="50_50"
              class="split-btn py-3 px-3 rounded-2xl font-bold text-xs sm:text-sm border transition-all text-center bg-[#6366F1] text-white border-[#6366F1] shadow-sm shadow-[#6366F1]/20"
            >
              50 / 50 (Mitad y Mitad)
            </button>
            <button
              type="button"
              data-mode="60_40"
              class="split-btn py-3 px-3 rounded-2xl font-bold text-xs sm:text-sm border border-[#E2E8F0] bg-[#F8FAFC] text-[#475569] hover:bg-white transition-all text-center"
            >
              60 / 40 (Proporcional)
            </button>
            <button
              type="button"
              data-mode="70_30"
              class="split-btn py-3 px-3 rounded-2xl font-bold text-xs sm:text-sm border border-[#E2E8F0] bg-[#F8FAFC] text-[#475569] hover:bg-white transition-all text-center"
            >
              70 / 30 (Sueldos)
            </button>
          </div>
        </div>

        <!-- Payer Selection -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-[#64748B] mb-2">
            ¿Quién pagó la cuenta?
          </label>
          <div class="grid grid-cols-2 gap-3">
            <button
              type="button"
              data-payer="you"
              class="payer-btn py-3 px-4 rounded-2xl font-bold text-xs sm:text-sm border transition-all flex items-center justify-center gap-2 bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE]"
            >
              <span class="w-6 h-6 rounded-full bg-[#6366F1] text-white text-[10px] flex items-center justify-center">Tú</span>
              <span>Pagué Yo</span>
            </button>
            <button
              type="button"
              data-payer="partner"
              class="payer-btn py-3 px-4 rounded-2xl font-bold text-xs sm:text-sm border border-[#E2E8F0] bg-[#F8FAFC] text-[#475569] hover:bg-white transition-all flex items-center justify-center gap-2"
            >
              <span class="w-6 h-6 rounded-full bg-[#F43F5E] text-white text-[10px] flex items-center justify-center">Ca</span>
              <span>Pagó Mi Pareja</span>
            </button>
          </div>
        </div>

        <!-- Dynamic Result Card -->
        <div id="calc-result" class="p-6 rounded-3xl bg-gradient-to-tr from-[#ECFDF5] to-white border border-[#A7F3D0] shadow-sm transition-all duration-300">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold uppercase tracking-wider text-[#065F46]">Resultado del Balance</span>
            <span id="result-status-tag" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#10B981] text-white">
              Te deben dinero
            </span>
          </div>
          <div class="my-2">
            <p id="result-text" class="text-3xl sm:text-4xl font-black text-[#10B981] tracking-tight">
              +$60.00 <span class="text-base font-semibold text-[#065F46]">USD</span>
            </p>
          </div>
          <p id="result-explanation" class="text-xs text-[#047857]">
            Tú pagaste los $120.00 completos. Tu pareja debe transferirte $60.00 para quedar en balance 50/50.
          </p>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  let activeMode = '50_50';
  let activePayer = 'you';

  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const splitBtns = document.querySelectorAll('.split-btn');
  const payerBtns = document.querySelectorAll('.payer-btn');
  const resultCard = document.getElementById('calc-result');
  const resultText = document.getElementById('result-text');
  const resultTag = document.getElementById('result-status-tag');
  const resultExplanation = document.getElementById('result-explanation');

  function calculate() {
    if (!amountInput || !resultText || !resultTag || !resultExplanation || !resultCard) return;
    const total = parseFloat(amountInput.value) || 0;

    let yourRatio = 0.5;
    let partnerRatio = 0.5;

    if (activeMode === '60_40') {
      yourRatio = 0.6;
      partnerRatio = 0.4;
    } else if (activeMode === '70_30') {
      yourRatio = 0.7;
      partnerRatio = 0.3;
    }

    if (activePayer === 'you') {
      // Tú pagaste todo, la pareja te debe su parte
      const partnerOwes = total * partnerRatio;
      resultText.className = 'text-3xl sm:text-4xl font-black text-[#10B981] tracking-tight';
      resultText.innerHTML = `+$${partnerOwes.toFixed(2)} <span class="text-base font-semibold text-[#065F46]">USD</span>`;
      resultTag.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#10B981] text-white';
      resultTag.textContent = 'Te deben dinero';
      resultCard.className = 'p-6 rounded-3xl bg-gradient-to-tr from-[#ECFDF5] to-white border border-[#A7F3D0] shadow-sm transition-all duration-300';
      resultExplanation.className = 'text-xs text-[#047857]';
      resultExplanation.textContent = `Tú pagaste los $${total.toFixed(2)} completos. Tu pareja te debe $${partnerOwes.toFixed(2)} (${Math.round(partnerRatio * 100)}%).`;
    } else {
      // La pareja pagó todo, tú le debes tu parte
      const youOwe = total * yourRatio;
      resultText.className = 'text-3xl sm:text-4xl font-black text-[#F97316] tracking-tight';
      resultText.innerHTML = `-$${youOwe.toFixed(2)} <span class="text-base font-semibold text-[#9A3412]">USD</span>`;
      resultTag.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#F97316] text-white';
      resultTag.textContent = 'Debes pagar';
      resultCard.className = 'p-6 rounded-3xl bg-gradient-to-tr from-[#FFF7ED] to-white border border-[#FED7AA] shadow-sm transition-all duration-300';
      resultExplanation.className = 'text-xs text-[#C2410C]';
      resultExplanation.textContent = `Tu pareja pagó los $${total.toFixed(2)}. Tú debes transferirle $${youOwe.toFixed(2)} (${Math.round(yourRatio * 100)}%).`;
    }
  }

  amountInput?.addEventListener('input', calculate);

  splitBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      splitBtns.forEach(b => {
        b.className = 'split-btn py-3 px-3 rounded-2xl font-bold text-xs sm:text-sm border border-[#E2E8F0] bg-[#F8FAFC] text-[#475569] hover:bg-white transition-all text-center';
      });
      btn.className = 'split-btn py-3 px-3 rounded-2xl font-bold text-xs sm:text-sm border transition-all text-center bg-[#6366F1] text-white border-[#6366F1] shadow-sm shadow-[#6366F1]/20';
      activeMode = btn.getAttribute('data-mode') || '50_50';
      calculate();
    });
  });

  payerBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      payerBtns.forEach(b => {
        b.className = 'payer-btn py-3 px-4 rounded-2xl font-bold text-xs sm:text-sm border border-[#E2E8F0] bg-[#F8FAFC] text-[#475569] hover:bg-white transition-all flex items-center justify-center gap-2';
      });
      btn.className = 'payer-btn py-3 px-4 rounded-2xl font-bold text-xs sm:text-sm border transition-all flex items-center justify-center gap-2 bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE]';
      activePayer = btn.getAttribute('data-payer') || 'you';
      calculate();
    });
  });

  calculate();
</script>
