---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0F172A] text-[#94A3B8] py-16 border-t border-[#1E293B]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand column -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-2xl bg-[#1E293B] p-1 border border-[#334155] shadow-sm flex items-center justify-center">
            <img src="/icons/vibecraft_icon.png" alt="VibeCraft Icon" class="w-full h-full object-contain" />
          </div>
          <span class="text-xl font-extrabold text-white font-['Plus_Jakarta_Sans']">Vibe<span class="text-[#6366F1]">Craft</span></span>
        </div>
        <p class="text-xs text-[#64748B] leading-relaxed">
          Estudio de desarrollo de software especializado en Flutter, arquitecturas reactivas en tiempo real y productos digitales de alta gama.
        </p>
      </div>

      <!-- Links 1: Productos -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Nuestra Suite</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#duoledger" class="hover:text-white transition-colors">DuoLedger (App de Parejas)</a></li>
          <li><a href="#suite" class="hover:text-white transition-colors">QuoteCraft (Presupuestos B2B)</a></li>
          <li><a href="#suite" class="hover:text-white transition-colors">FocusFlow (Productividad TDAH)</a></li>
          <li><a href="#suite" class="hover:text-white transition-colors">SnapBite (AI Calorie Tracker)</a></li>
        </ul>
      </div>

      <!-- Links 2: Stack & Arquitectura -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Arquitectura</h4>
        <ul class="space-y-2 text-xs">
          <li><span class="text-[#64748B]">Flutter Multiplataforma</span></li>
          <li><span class="text-[#64748B]">NestJS & WebSockets</span></li>
          <li><span class="text-[#64748B]">PostgreSQL & Transacciones ACID</span></li>
          <li><span class="text-[#64748B]">VaultS3 Object Storage</span></li>
          <li><span class="text-[#64748B]">Despliegue Docker en Droplet</span></li>
        </ul>
      </div>

      <!-- Links 3: Contacto -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Hablemos</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="https://wa.me/?text=Hola%20VibeCraft" target="_blank" class="hover:text-white transition-colors flex items-center gap-1.5">
              <span>WhatsApp Directo</span>
            </a>
          </li>
          <li><span class="text-[#64748B]">Disponibles para proyectos selectos</span></li>
          <li><span class="text-[#64748B]">Despliegue en DigitalOcean / VPS</span></li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 border-t border-[#1E293B] flex flex-col sm:flex-row items-center justify-between text-xs text-[#64748B] gap-4">
      <p>© {currentYear} VibeCraft Studio. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="#duoledger" class="hover:text-white transition-colors">DuoLedger</a>
        <a href="#suite" class="hover:text-white transition-colors">Suite</a>
        <a href="#calculator" class="hover:text-white transition-colors">Simulador</a>
      </div>
    </div>

  </div>
</footer>
