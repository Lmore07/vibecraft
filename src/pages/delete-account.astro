---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const apps = [
  {
    name: "DuoLedger",
    subtitle: "Finanzas en Pareja & Gastos Compartidos",
    slug: "duoledger",
    status: "active",
    statusText: "Activa en Google Play",
    icon: "/icons/vibecraft_icon.png",
    color: "from-rose-500 to-pink-600",
    description: "Sincronización en tiempo real de finanzas, balances y metas de ahorro para parejas.",
    deletionUrl: "/duoledger/delete-account",
  },
  {
    name: "QuoteCraft",
    subtitle: "Cotizaciones Profesionales B2B",
    slug: "quotecraft",
    status: "upcoming",
    statusText: "Próximo Lanzamiento",
    icon: "/icons/vibecraft_icon.png",
    color: "from-blue-500 to-indigo-600",
    description: "Generación instantánea de presupuestos con firma digital y pasarela de cobro.",
    deletionUrl: null,
  },
  {
    name: "FocusFlow",
    subtitle: "Productividad y Rutinas TDAH",
    slug: "focusflow",
    status: "upcoming",
    statusText: "Próximo Lanzamiento",
    icon: "/icons/vibecraft_icon.png",
    color: "from-emerald-500 to-teal-600",
    description: "Temporizadores visuales neuronales y gamificación anti-procrastinación.",
    deletionUrl: null,
  },
  {
    name: "SnapBite",
    subtitle: "AI Calorie & Macro Tracker",
    slug: "snapbite",
    status: "upcoming",
    statusText: "Próximo Lanzamiento",
    icon: "/icons/vibecraft_icon.png",
    color: "from-amber-500 to-orange-600",
    description: "Registro de calorías y macronutrientes mediante reconocimiento visual con IA.",
    deletionUrl: null,
  },
];
---

<Layout
  title="Centro de Eliminación de Cuentas y Datos — VibeCraft Apps"
  description="Portal global de gestión de cuentas y solicitud de eliminación de datos personales de las aplicaciones móviles y servicios desarrollados por VibeCraft Apps."
>
  <Navbar />

  <main class="pt-32 pb-24 bg-[#F8FAFC]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Encabezado Principal -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-[#F1F5F9] shadow-sm mb-10 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EEF2FF] text-[#4F46E5] text-xs font-bold uppercase tracking-wider mb-4 border border-[#E0E7FF]">
          <span>🛡️ Privacidad & Control de Usuario • VibeCraft Apps</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#0F172A] tracking-tight font-['Plus_Jakarta_Sans'] mb-4">
          Centro de Eliminación de Cuentas
        </h1>
        <p class="text-base sm:text-lg text-[#475569] leading-relaxed max-w-2xl">
          Selecciona la aplicación de la cual deseas gestionar o solicitar la eliminación definitiva de tu cuenta y datos personales asociados.
        </p>
      </div>

      <!-- Directorio de Aplicaciones -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        {apps.map((app) => (
          <div class={`bg-white rounded-3xl p-6 sm:p-8 border ${app.status === 'active' ? 'border-[#6366F1]/40 shadow-md shadow-[#6366F1]/5' : 'border-[#F1F5F9] shadow-xs'} flex flex-col justify-between space-y-6`}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] p-1.5 flex items-center justify-center">
                  <img src={app.icon} alt={app.name} class="w-full h-full object-contain" />
                </div>
                {app.status === 'active' ? (
                  <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    {app.statusText}
                  </span>
                ) : (
                  <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-medium border border-slate-200">
                    {app.statusText}
                  </span>
                )}
              </div>

              <h2 class="text-xl font-bold text-[#0F172A] font-['Plus_Jakarta_Sans'] mb-1">
                {app.name}
              </h2>
              <p class="text-xs font-semibold text-[#6366F1] mb-3">
                {app.subtitle}
              </p>
              <p class="text-xs text-[#64748B] leading-relaxed">
                {app.description}
              </p>
            </div>

            <div>
              {app.deletionUrl ? (
                <a
                  href={app.deletionUrl}
                  class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-700 hover:to-pink-700 text-white font-bold text-xs shadow-sm flex items-center justify-center gap-2 transition-all"
                >
                  <span>Gestionar Baja en {app.name}</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </a>
              ) : (
                <div class="p-3 rounded-xl bg-[#F8FAFC] border border-[#F1F5F9] text-center">
                  <span class="text-xs text-[#94A3B8] font-medium">
                    Servicio en fase preliminar • No almacena datos de usuarios
                  </span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Compromiso Global de Privacidad -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-[#F1F5F9] shadow-sm space-y-4">
        <h3 class="text-xl font-bold text-[#0F172A] font-['Plus_Jakarta_Sans']">
          Compromiso de Privacidad y Cumplimiento Legal
        </h3>
        <p class="text-sm text-[#475569] leading-relaxed">
          En <strong>VibeCraft Apps</strong>, cada producto cuenta con un ciclo de vida de datos independiente. Cuando solicitas la eliminación en una aplicación específica, tus datos no se comparten ni persisten en ningún otro servicio del ecosistema.
        </p>
        <p class="text-xs text-[#64748B]">
          Si tienes dudas o necesitas asistencia manual para cualquier servicio de nuestra suite, contáctanos en <a href="mailto:privacy@vibecraftapps.com" class="text-[#6366F1] font-semibold underline">privacy@vibecraftapps.com</a>.
        </p>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
