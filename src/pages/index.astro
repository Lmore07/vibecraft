---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import DuoLedgerShowcase from '../components/DuoLedgerShowcase.astro';
import InteractiveCalculator from '../components/InteractiveCalculator.astro';
import ProductSuite from '../components/ProductSuite.astro';
import TechStack from '../components/TechStack.astro';
import StudioCapabilities from '../components/StudioCapabilities.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="VibeCraft Studio — Software Lab, Flutter Apps & Creadores de DuoLedger"
  description="Estudio de ingeniería de software especializado en aplicaciones móviles en tiempo real con Flutter, NestJS, PostgreSQL y VaultS3. Creadores de DuoLedger."
>
  <Navbar />
  <main>
    <Hero />
    <DuoLedgerShowcase />
    <InteractiveCalculator />
    <ProductSuite />
    <TechStack />
    <StudioCapabilities />
    <ContactSection />
  </main>
  <Footer />
</Layout>
