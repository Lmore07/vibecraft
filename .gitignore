# ==========================================
# VibeCraft - .gitignore
# ==========================================

# Build output
dist/
build/
.astro/

# Dependencies
node_modules/
.pnpm-store/

# Environment & Sensitive variables
.env
.env.*
!.env.example
*.env
*.env.local

# Vercel deployment cache and secrets
.vercel/

# Temporary & Helper scripts
convert_icon.js
convert_ai_logos.js
generate_logo_lockup.js

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# SSL Certificates, Keys & Credentials
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
credentials.json
secrets.json
